{
 "doctype": "DocType",
 "icon": "fa fa-money",
 "name": "Finance Txn",
 "module": "Finance",
 "custom": 0,
 "istable": 0,
 "allow_rename": 0,
 "engine": "InnoDB",
 "autoname": "FTX-.#####",
 "title_field": "ref",
 "show_title_field_in_link": 1,
 "search_fields": "ref,type",
 "sort_field": "modified",
 "sort_order": "desc",
 "track_changes": 1,
 "is_submittable": 1,
 "fields": [
  {
   "fieldname": "type",
   "label": "Type",
   "fieldtype": "Select",
   "options": "revenue\nrefund\ntax\nexpense\npayment",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "amount_minor",
   "label": "Amount (minor units)",
   "fieldtype": "Int",
   "reqd": 1
  },
  {
   "fieldname": "currency",
   "label": "Currency",
   "fieldtype": "Data",
   "reqd": 1,
   "length": 3
  },
  {
   "fieldname": "ref",
   "label": "Reference",
   "fieldtype": "Data",
   "in_list_view": 1,
   "description": "e.g. Reservation name or payment_reference"
  },
  {
   "fieldname": "reservation",
   "label": "Reservation",
   "fieldtype": "Link",
   "options": "Reservation",
   "in_list_view": 1,
   "description": "Set for folio charges/payments; blank for standalone expenses etc."
  },
  {
   "fieldname": "payment_method",
   "label": "Payment Method",
   "fieldtype": "Select",
   "options": "\ncash\nmobile_money\nbank_transfer\ncard\nother",
   "depends_on": "eval:doc.type=='payment'",
   "description": "Manual/offline payment recording only -- no gateway wired up yet"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Finance Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1,
   "submit": 1,
   "cancel": 1
  }
 ]
}
