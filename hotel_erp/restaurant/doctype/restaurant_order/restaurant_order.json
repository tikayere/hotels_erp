{
 "doctype": "DocType",
 "icon": "fa fa-cutlery",
 "name": "Restaurant Order",
 "module": "Restaurant",
 "custom": 0,
 "istable": 0,
 "allow_rename": 0,
 "engine": "InnoDB",
 "autoname": "RO-.#####",
 "title_field": "reservation",
 "show_title_field_in_link": 1,
 "search_fields": "reservation,status",
 "sort_field": "modified",
 "sort_order": "desc",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "reservation",
   "label": "Reservation",
   "fieldtype": "Link",
   "options": "Reservation",
   "in_list_view": 1
  },
  {
   "fieldname": "items",
   "label": "Items",
   "fieldtype": "JSON",
   "reqd": 1,
   "description": "Array of {item, qty, price_minor}. An entry whose \"item\" exactly matches an Inventory Item's item_name is stock-tracked (decremented when the order is served); freeform menu items with no matching Inventory Item are not."
  },
  {
   "fieldname": "assigned_to",
   "label": "Assigned To",
   "fieldtype": "Link",
   "options": "User",
   "in_list_view": 1,
   "description": "Kitchen staff auto-assigned (least-loaded active Restaurant-department Staff) when the order enters in_kitchen"
  },
  {
   "fieldname": "amount_minor",
   "label": "Amount (minor units)",
   "fieldtype": "Int",
   "reqd": 1
  },
  {
   "fieldname": "currency",
   "label": "Currency",
   "fieldtype": "Data",
   "reqd": 1,
   "length": 3
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "placed\nin_kitchen\nserved\nbilled\ncancelled",
   "reqd": 1,
   "default": "placed",
   "in_list_view": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Hotel Front Desk",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  }
 ]
}
