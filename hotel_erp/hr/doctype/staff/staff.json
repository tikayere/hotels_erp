{
 "doctype": "DocType",
 "icon": "fa fa-users",
 "name": "Staff",
 "module": "HR",
 "custom": 0,
 "istable": 0,
 "allow_rename": 0,
 "engine": "InnoDB",
 "autoname": "EMP-.#####",
 "title_field": "employee_name",
 "show_title_field_in_link": 1,
 "search_fields": "employee_name,phone,email",
 "sort_field": "modified",
 "sort_order": "desc",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "employee_name",
   "label": "Employee Name",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "department",
   "label": "Department",
   "fieldtype": "Select",
   "options": "Front Desk\nHousekeeping\nMaintenance\nRestaurant\nFinance\nHR\nManagement",
   "in_list_view": 1
  },
  {
   "fieldname": "designation",
   "label": "Designation",
   "fieldtype": "Data"
  },
  {
   "fieldname": "phone",
   "label": "Phone",
   "fieldtype": "Data"
  },
  {
   "fieldname": "email",
   "label": "Email",
   "fieldtype": "Data"
  },
  {
   "fieldname": "date_of_joining",
   "label": "Date of Joining",
   "fieldtype": "Date"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "active\non_leave\nterminated",
   "default": "active",
   "in_list_view": 1
  },
  {
   "fieldname": "user",
   "label": "Linked User",
   "fieldtype": "Link",
   "options": "User"
  },
  {
   "fieldname": "daily_rate_minor",
   "label": "Daily Rate (minor units)",
   "fieldtype": "Int",
   "description": "Used by hotel_erp.hr.payroll.generate_payroll_entries; unset means this staff member is skipped when generating a pay period"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "HR Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  }
 ]
}
