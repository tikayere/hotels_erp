{
 "doctype": "DocType",
 "icon": "fa fa-building",
 "name": "Property",
 "module": "Property",
 "custom": 0,
 "istable": 0,
 "allow_rename": 0,
 "engine": "InnoDB",
 "autoname": "field:code",
 "title_field": "property_name",
 "show_title_field_in_link": 1,
 "search_fields": "property_name,city,code",
 "sort_field": "modified",
 "sort_order": "desc",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "code",
   "label": "Code",
   "fieldtype": "Data",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "property_name",
   "label": "Property Name",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "branch_name",
   "label": "Branch Name",
   "fieldtype": "Data"
  },
  {
   "fieldname": "address",
   "label": "Address",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "city",
   "label": "City",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "country",
   "label": "Country",
   "fieldtype": "Data",
   "reqd": 1,
   "length": 2,
   "description": "ISO-3166 alpha-2"
  },
  {
   "fieldname": "lat",
   "label": "Latitude",
   "fieldtype": "Float"
  },
  {
   "fieldname": "lon",
   "label": "Longitude",
   "fieldtype": "Float"
  },
  {
   "fieldname": "star_rating",
   "label": "Star Rating",
   "fieldtype": "Int",
   "description": "1-5"
  },
  {
   "fieldname": "branding_section",
   "label": "Guest Booking Portal Branding",
   "fieldtype": "Section Break",
   "description": "Shown to guests on the public booking portal (/book) and printed on the downloadable booking ticket -- see hotel_erp.api.public_booking.get_portal_settings."
  },
  {
   "fieldname": "logo",
   "label": "Logo",
   "fieldtype": "Attach Image"
  },
  {
   "fieldname": "phone",
   "label": "Phone",
   "fieldtype": "Data"
  },
  {
   "fieldname": "email",
   "label": "Email",
   "fieldtype": "Data",
   "options": "Email"
  },
  {
   "fieldname": "website",
   "label": "Website",
   "fieldtype": "Data"
  },
  {
   "fieldname": "column_break_branding",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "tagline",
   "label": "Tagline",
   "fieldtype": "Data",
   "description": "Short hero line on the booking portal home page, e.g. \"Comfort in the heart of the city.\""
  },
  {
   "fieldname": "description",
   "label": "About / Description",
   "fieldtype": "Text Editor",
   "description": "Longer \"About Us\" copy for the booking portal home page."
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Active\nSuspended",
   "reqd": 1,
   "default": "Active",
   "in_list_view": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Hotel Front Desk",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "Hotel API",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1
  }
 ]
}
