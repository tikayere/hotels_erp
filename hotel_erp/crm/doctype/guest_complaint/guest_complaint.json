{
 "doctype": "DocType",
 "icon": "fa fa-exclamation-triangle",
 "name": "Guest Complaint",
 "module": "CRM",
 "custom": 0,
 "istable": 0,
 "allow_rename": 0,
 "engine": "InnoDB",
 "autoname": "GCM-.#####",
 "title_field": "guest",
 "show_title_field_in_link": 1,
 "search_fields": "guest,category",
 "sort_field": "modified",
 "sort_order": "desc",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "guest",
   "label": "Guest",
   "fieldtype": "Link",
   "options": "Guest",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "reservation",
   "label": "Reservation",
   "fieldtype": "Link",
   "options": "Reservation"
  },
  {
   "fieldname": "category",
   "label": "Category",
   "fieldtype": "Select",
   "options": "room\nservice\nbilling\ncleanliness\nnoise\nother",
   "in_list_view": 1
  },
  {
   "fieldname": "description",
   "label": "Description",
   "fieldtype": "Text",
   "reqd": 1
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "open\nin_progress\nresolved\nescalated",
   "default": "open",
   "in_list_view": 1
  },
  {
   "fieldname": "priority",
   "label": "Priority",
   "fieldtype": "Select",
   "options": "low\nmedium\nhigh\nurgent",
   "default": "medium"
  },
  {
   "fieldname": "assigned_to",
   "label": "Assigned To",
   "fieldtype": "Link",
   "options": "User",
   "in_list_view": 1
  },
  {
   "fieldname": "due_by",
   "label": "Due By",
   "fieldtype": "Datetime",
   "description": "SLA deadline, computed from priority when raised"
  },
  {
   "fieldname": "resolution",
   "label": "Resolution",
   "fieldtype": "Text"
  },
  {
   "fieldname": "raised_at",
   "label": "Raised At",
   "fieldtype": "Datetime",
   "in_list_view": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Hotel Front Desk",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  }
 ]
}
